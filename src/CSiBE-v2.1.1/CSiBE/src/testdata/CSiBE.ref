  "",
  "",
  "%if-c-only",
  "m4_ifdef( [[M4_YY_NO_UNPUT]],,",
  "[[",
  "    static void yyunput YYFARGS2( int,c, register char *,yy_bp)",
  "%endif",
  "%if-c++-only",
