#include <stdio.h>
#include "rtv.h"

int main(int argc, char ** argv)
{
    int r;
    int i;

    for (i = 1; i < argc; i++) {
        r = rtv_set_replaytv_version(argv[i]);
        printf("%-20s  ", argv[i]);
        if (r < 0)
            printf("Failed\n");
        else
            printf("%d.%d.%d (%d)\n",
                   replaytv_version.major,
                   replaytv_version.minor,
                   replaytv_version.patch,
                   replaytv_version.build);
    }
    return 0;
}
