#!/bin/bash

set -euo pipefail

if [ "$#" -ne 3 ]; then
    echo "Usage: $0 OUTPUT COMPILER FLAGS" >&2
    exit 2
fi

OUTPUT=$1
COMPILER=$2
FLAGS=$3

COMPILER_VERSION=$("$COMPILER" --version | sed -n '1p')

mkdir -p "$(dirname "$OUTPUT")"
TEMP_FILE=$(mktemp "${OUTPUT}.tmp.XXXXXX")

trap 'rm -f "$TEMP_FILE"' EXIT

{
    printf 'Compiler version,%s\n' "$COMPILER_VERSION"
    printf 'Compiler flags,%s\n' "$FLAGS"
    printf '\n'
    printf 'Date,%s\n' "$(date '+%F')"
    printf '\n'
    printf '%s\n' \
        'benchmark,object,text,data,bss,rom_size,object_file_size'

    while IFS= read -r -d '' RESULT_FILE; do
        PROJECT=$(basename "$(dirname "$RESULT_FILE")")
        IFS= read -r HEADER < "$RESULT_FILE"

        EXPECTED_HEADER='object,text,data,bss,rom_size,object_file_size'

        if [ "$HEADER" != "$EXPECTED_HEADER" ]; then
            echo "Unexpected CSV header in $RESULT_FILE: $HEADER" >&2
            exit 1
        fi

        while IFS= read -r ROW; do
            if [ -n "$ROW" ]; then
                printf '%s,%s\n' "$PROJECT" "$ROW"
            fi
        done < <(tail -n +2 "$RESULT_FILE")
    done < <(
        find . -type f -name 'result.csv' -print0 |
            LC_ALL=C sort -z
    )
} > "$TEMP_FILE"

mv -f "$TEMP_FILE" "$OUTPUT"
trap - EXIT